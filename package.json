{
  "name": "all-in-one-workspace",
  "version": "1.2.10",
  "private": true,
  "description": "A personal, extensible local desktop workspace",
  "author": "All In One Workspace contributors",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "pnpm build && playwright test",
    "build": "pnpm check && electron-vite build",
    "dist": "pnpm build && pnpm build:installer && electron-builder --mac --publish never",
    "build:installer": "node scripts/build-installer.mjs",
    "release:keygen": "node scripts/release.mjs keygen",
    "dist:release": "node scripts/release.mjs build",
    "release": "node scripts/release.mjs draft",
    "test:installer": "node scripts/test-installer.mjs"
  },
  "dependencies": {
    "cheerio": "1.1.2",
    "imapflow": "^2.12.2",
    "lucide-react": "1.77.0",
    "mailparser": "^3.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-grid-layout": "2.3.0",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
